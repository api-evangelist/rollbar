{
  "opencollection": "1.0.0",
  "info": {
    "name": "Rollbar Deployment Access Tokens Resolution Time Metrics API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Rollbar-Access-Token",
      "value": "{{X-Rollbar-Access-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Resolution Time Metrics",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Resolution Time Metrics for a List of Projects",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.rollbar.com/api/1/metrics/ttr",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Returns resolution time (time-to-resolve) metrics for a provided list of project IDs. Results can be filtered by environments, levels, and frameworks."
        }
      ]
    }
  ],
  "bundled": true
}