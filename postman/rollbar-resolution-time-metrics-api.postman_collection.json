                  "raw": "{{baseUrl}}/metrics/ttr",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "metrics",
                    "ttr"
                  ]
                },
                "description": "Returns resolution time (time-to-resolve) metrics for a provided list of project IDs. Results can be filtered by environments, levels, and frameworks."
