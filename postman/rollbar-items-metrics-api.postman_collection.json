                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"item_ids\": [\n    \"<integer>\",\n    \"<integer>\"\n  ],\n  \"start_time\": \"<integer>\",\n  \"end_time\": \"<integer>\",\n  \"filters\": [\n    {\n      \"field\": \"<string>\",\n      \"operator\": \"nin\",\n      \"value\": {\n        \"description\": \"The value to compare against. Type depends on the field and operator.\"\n      }\n    },\n    {\n      \"field\": \"<string>\",\n      \"operator\": \"lte\",\n      \"value\": {\n        \"description\": \"The value to compare against. Type depends on the field and operator.\"\n      }\n    }\n  ],\n  \"group_by\": [\n    \"<string>\",\n    \"<string>\"\n  ]\n}",
