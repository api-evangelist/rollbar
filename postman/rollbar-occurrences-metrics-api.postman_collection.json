                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"start_time\": \"<integer>\",\n  \"end_time\": \"<integer>\",\n  \"filters\": [\n    {\n      \"field\": \"<string>\",\n      \"operator\": \"gte\",\n      \"value\": {\n        \"description\": \"The value to compare against. Type depends on the field and operator.\"\n      }\n    },\n    {\n      \"field\": \"<string>\",\n      \"operator\": \"neq\",\n      \"value\": {\n        \"description\": \"The value to compare against. Type depends on the field and operator.\"\n      }\n    }\n  ],\n  \"group_by\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"aggregate\": \"sum\"\n}",
